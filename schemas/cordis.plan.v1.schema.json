{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordis.local/schemas/cordis.plan.v1.schema.json",
  "title": "CORDIS PlanIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "version",
    "task_id",
    "workflow_id",
    "goal",
    "steps",
    "completion_gate"
  ],
  "properties": {
    "schema": {
      "const": "cordis.plan.v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "confidence_id"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confidence_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "allowed_scope",
          "action_class",
          "method",
          "tool_policy",
          "required_evidence",
          "approval_required",
          "retry_limit",
          "on_success",
          "on_failure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 100
          },
          "allowed_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 100
          },
          "action_class": {
            "enum": [
              "read",
              "research",
              "change",
              "verify"
            ]
          },
          "method": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recommended"
            ],
            "properties": {
              "recommended": {
                "type": "string",
                "minLength": 1
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 100
              }
            }
          },
          "tool_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allowed"
            ],
            "properties": {
              "recommended": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 100
              },
              "allowed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 100
              },
              "forbidden": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 100
              }
            }
          },
          "model_requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reasoning": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "coding": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tool_use": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "context_capacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "review": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_required": {
            "type": "boolean"
          },
          "retry_limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "stop_when": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 100
          },
          "on_success": {
            "type": "string",
            "minLength": 1
          },
          "on_failure": {
            "enum": [
              "replan",
              "block",
              "finish"
            ]
          }
        }
      }
    },
    "completion_gate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
