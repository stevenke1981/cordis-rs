{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordis.local/schemas/cordis.step-result.v1.schema.json",
  "title": "CORDIS Step Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "plan_id",
    "plan_version",
    "step_id",
    "status",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "cordis.step-result.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "failure",
        "blocked"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "cordis.evidence.v1.schema.json"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "summary"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proposed_next": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
